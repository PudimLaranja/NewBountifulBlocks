{
	"schemaVersion": 1,
	"id": "bountiful",
	"version": "${version}",
	"name": "NewBountifulBlocks",
	"description": "Port of the mod BountifulBlocks by ultimatech to 26.1.2 with some new additions",
	"authors": [
		"PudimLaranja",
		"Ultimatech"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/bountifulblocks/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.bountiful.blocks.NewBountifulBlocks"
		],
		"client": [
			"com.bountiful.blocks.client.NewBountifulBlocksClient"
		]
	},
	"mixins": [
		"bountiful.mixins.json",
		{
			"config": "bountiful.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}